{
  "name": "apex-rankmap-notifier",
  "version": "1.0.0",
  "private": true,
  "description": "Post the daily Apex Legends ranked map rotation to Discord once a day (GitHub Actions cron, zero runtime dependencies).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "post": "node --env-file-if-exists=.env src/jobs/postSchedule.ts",
    "post:mock": "USE_MOCK=true node --env-file-if-exists=.env src/jobs/postSchedule.ts",
    "post:dry": "DRY_RUN=true node --env-file-if-exists=.env src/jobs/postSchedule.ts",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "5.9.3"
  }
}
