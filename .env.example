# このファイルを .env にコピーしてローカル開発に使う。
# 本物の .env は .gitignore 済み。絶対にコミットしないこと。
#   cp .env.example .env

# Apex Legends Status API キー（https://apexlegendsapi.com で取得）。
# 未設定の場合は自動でモックモードになる。
APEX_API_KEY=

# Discord Webhook URL。
# 対象チャンネル → 連携 → Webhook → 新しいWebhook → URLをコピー。
# これ自体が認証情報（知っている人は誰でも投稿できる）。秘密として扱うこと。
DISCORD_WEBHOOK_URL=

# true にすると実APIを呼ばずダミーデータを使う。
USE_MOCK=false

# true にすると Discord へ送信せず、文面と文字数を標準出力に出すだけにする。
# state も更新しないので、フォーマットの調整はこれで回す。
DRY_RUN=false

# true にすると「本日は投稿済み」の判定を無視して再投稿する。
FORCE=false

# 任意: モック時の1枠の長さ（分）。既定は 270（4.5時間）。
# 枠が短いときに短縮形へ切り替わるかを試すのに使う。
# MOCK_SLOT_MINUTES=180
